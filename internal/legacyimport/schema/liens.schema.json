{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ledgertrack/import/liens.schema.json",
  "title": "LedgerTrack legacy import: liens.jsonl line (hold)",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "account_source_id", "reference", "amount", "created_at"],
  "properties": {
    "source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "account_source_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "reference": { "type": "string", "pattern": "^[\\x21-\\x7e]{1,200}$", "description": "Original legacy reference of the hold. Used verbatim as the reference of the lien transaction, so it must be unique across the ledger." },
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "description": "Positive decimal string in major units." },
    "created_at": { "type": "string", "format": "date-time", "description": "When the hold was placed in the legacy system. Stored in transaction metadata." },
    "description": { "type": "string", "maxLength": 500 }
  }
}
